DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres:///biard

# آدرس فرانت‌اند
FRONTEND_URL=http://localhost:3100
# تازه‌سازی کش Next.js؛ مقدار secret باید با REVALIDATE_SECRET فرانت‌اند یکی باشد
FRONTEND_REVALIDATE_URL=http://localhost:3100/api/revalidate
REVALIDATE_SECRET=change-me-too

# fake فقط برای توسعه است و با DEBUG=false کار نمی‌کند
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# console کد را در لاگ می‌نویسد؛ روی سرور واقعی باید سرویس پیامک وصل شود
SMS_BACKEND=console
